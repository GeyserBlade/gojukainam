# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml
yarn.lock

# Build outputs
dist/
build/
.cache/
.vite/
.next/

# Local environment
.env
.env.local
.env.*.local

# Backend env files hold real credentials — the production DATABASE_URL among
# them. The three patterns above do NOT cover backend/.env.production, which is
# exactly the name someone reaches for when they need a production connection
# string, and it sat untracked-but-committable until this rule existed.
#
# Scoped to backend/ rather than a blanket .env.* because frontend/.env.production
# is deliberately tracked: it holds VITE_API_BASE, a public build-time value.
backend/.env.*
!backend/.env.example

# Prisma
/prisma/dev.db
/prisma/dev.db-journal
# Keep migrations for production deployment - DO NOT ignore
# prisma/migrations/

# Logs
logs/
*.log
*.log.*
*.out
*.pid
*.seed

# OS junk
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
.claude/settings.local.json

# Local agent/skill tooling. Kept out of git deliberately: this repo is public,
# and these are per-machine working files rather than anything a collaborator
# needs to build or run the app.
.agents/
.claude/skills/
skills-lock.json

# TypeScript build outputs
*.tsbuildinfo
tsconfig.tsbuildinfo

# Coverage
coverage/

# Docker volumes (optional, if you generate data locally)
docker-data/

# Backups written by scripts/delete-event.ts. These hold real competitor data —
# names, dates of birth, clubs — and this repo is public. Prefer writing them
# outside the repo entirely (--backup ~/somewhere/file.json); this rule is the
# second line of defence, not the first.
event-backup-*.json
