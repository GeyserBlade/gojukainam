{
  "name": "gojukainam-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "//engines": "Nixpacks picks its own Node when this is absent, and Prisma 7 raised its floor to ^20.19 || ^22.12 || >=24. Prisma 6 ran on older Node, which is why every deploy worked until the upgrade. CI pins 22 explicitly, so CI could not see the difference.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "//postinstall": "Prisma 7 dropped @prisma/client's automatic postinstall generate. Without this the production image installs the stock package, which exports no PrismaClient, and the server dies at import with a SyntaxError that names the export rather than the missing step.",
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "superuser-recovery": "tsx scripts/superuser-recovery.ts",
    "create-superuser": "tsx scripts/create-superuser.ts",
    "check-user": "tsx scripts/check-user.ts",
    "create-agent-key": "tsx scripts/create-agent-key.ts",
    "enable-club-billing": "tsx scripts/enable-club-billing.ts",
    "seed-club-fees": "tsx scripts/seed-club-fees.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.1.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "zod": "^4.1.5"
  }
}
