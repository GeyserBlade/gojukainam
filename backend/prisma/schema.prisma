// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// ---------------- Generators & Datasource ----------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------
enum Role {
  SUPERADMIN
  ADMIN
  CLUB_MANAGER
  COACH
  ATHLETE
  /// Runs the bouts on one tatami on the day. Sees only the mats they are
  /// assigned to (see MatOperator) and can record results there — nothing else
  /// in the system. Default-denied everywhere, like ATHLETE.
  TATAMI_OPERATOR
}

enum Gender {
  Male
  Female
}

enum EntryType {
  KATA
  KUMITE
  TEAM_KATA
  TEAM_KUMITE
  BUNKAI
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum TeamStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum InvoiceStatus {
  DUE
  SENT
  PAID
  CANCELLED
}

enum EventStatus {
  DRAFT       // Event being set up
  ACTIVE      // Open for entries
  CLOSED      // Entries closed, event in progress or completed
  ARCHIVED    // Historical event
}

enum DrawStatus {
  DRAWN       // Draw generated, no results captured yet
  IN_PROGRESS // At least one result captured
  COMPLETED   // All placements decided
}

enum BoutPhase {
  MAIN
  REPECHAGE
}

enum DocumentType {
  IDENTITY_DOCUMENT
  CLUB_MEMBERSHIP_FORM
  EVENT_ENTRY_FORM
  MEDICAL_CLEARANCE
  GRADING_CERTIFICATE
  PHOTO
  OTHER
}

// ---------------- Models ----------------
model User {
  id     String  @id @default(cuid())
  name   String?
  email  String  @unique
  role   Role
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  passwordHash String? // if you add password flow; for magic-link keep null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  AuditLogs      AuditLog[]
  PasswordResets PasswordReset[]
  documents      Document[]

  coordinatorFor    EventCoordinator[] @relation("CoordinatorUser")
  coordinatorGrants EventCoordinator[] @relation("CoordinatorGrantedBy")
  operatorFor       MatOperator[]      @relation("OperatorUser")
  operatorGrants    MatOperator[]      @relation("OperatorGrantedBy")
}

/// Per-event delegation: grants one user admin-equivalent powers over ONE event
/// (entries, draws, run-day, divisions and event config) without changing their
/// global Role. The host dojo's instructor keeps CLUB_MANAGER — and their club
/// scoping everywhere else — while running the tournament they host.
///
/// Deliberately NOT a Role enum value: a coordinator is an addition to whatever
/// the user already is, and the grant has to disappear when the event does.
/// Excluded from the grant by design: billing/invoices, user and club
/// management, deleting the event, and appointing further coordinators.
model EventCoordinator {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("CoordinatorUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Who appointed them. Kept for accountability; null if the appointer's user
  /// row is later removed.
  grantedById String?
  grantedBy   User?   @relation("CoordinatorGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model MagicLink {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Club {
  id          String  @id @default(cuid())
  name        String
  region      String?
  contactName String
  email       String
  phone       String?
  notes       String?

  users      User[]
  athletes   Athlete[]
  teams      Team[]
  entries    Entry[]
  invoices   Invoice[]
  documents  Document[]
  apiKeys    ApiKey[]

  // Club billing — see the billing section at the end of this file.
  billingConfig  ClubBillingConfig?
  feeSchedules   FeeSchedule[]
  invoiceRuns    InvoiceRun[]
  memberInvoices MemberInvoice[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Service-account credential for machine callers (the sensai agent stack).
/// Deliberately NOT a User: a key must never mint a role. See utils/agent-auth.ts.
model ApiKey {
  id     String  @id @default(cuid())
  name   String
  /// First 8 chars of the key — the lookup handle. Safe to log.
  prefix String  @unique
  /// sha256 of the whole key. The key itself is shown once, at creation, and
  /// is not recoverable from here.
  hashedKey String @unique
  /// Which club this key may act for. Required, and Restrict on delete, on
  /// purpose: a nullable clubId would mean "federation-wide" to
  /// assertAgentClub, so ON DELETE SET NULL would silently promote a
  /// club-scoped key to every club the moment someone deleted its club.
  /// Restrict makes that a loud failure the admin must resolve by revoking.
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  /// e.g. ["members:read","billing:read","billing:write","payments:write"]
  scopes String[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

model Event {
  id         String      @id @default(cuid())
  name       String
  venue      String
  city       String
  country    String
  startDate  DateTime
  regOpen    DateTime
  regClose   DateTime
  status     EventStatus @default(ACTIVE)
  /// JSON string of your YAML config (persisted snapshot)
  configJson String
  /// Tournament-wide timing defaults: mats, default bout duration, injury/
  /// stoppage buffer, changeover, ceremonies and the lunch break (including
  /// whether all mats close together or each floor breaks on its own).
  /// Shape and defaults live in `EventTimingConfig` (utils/validators.ts);
  /// null means "never configured" and readers fall back to those defaults.
  ///
  /// Deliberately a column of its own rather than a key inside `configJson`:
  /// that field is an unvalidated whole-object snapshot of the YAML rules and
  /// `PUT /events/:id/config` replaces it wholesale, so timing stored there
  /// would be silently clobbered by an unrelated config write.
  timingJson String?
  /// When set, a read-only public board is reachable at /board/<token>.
  /// null = public board disabled. Rotating the token revokes old links.
  publicToken String? @unique

  divisions     Division[]
  weightClasses WeightClass[]
  entries       Entry[]
  teams         Team[]
  invoices      Invoice[]
  documents     Document[]
  draws          Draw[]
  mats           Mat[]
  coordinators   EventCoordinator[]
  scheduleBlocks ScheduleBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

enum CategoryType {
  KATA
  KUMITE
}

model Division {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id])
  key       String       // e.g., "CADET_M", "SENIOR_F"
  name      String       // e.g., "Cadet Male (14-15)", "Senior Female"
  minAge    Int
  maxAge    Int
  gender    Gender
  category  CategoryType // KATA or KUMITE
  notes     String?

  /// Per-category timing. All three are nullable and null means "not
  /// overridden", never "zero": bout duration and buffer then fall back to the
  /// event's `timingJson` defaults, and the win-by-points gap falls back to the
  /// age-derived default (6 for categories capped at 13, 8 above — see
  /// defaultWinByGap in the frontend's lib/timing.ts).
  boutDurationSec Int?
  bufferPct       Float?
  winByGap        Int?

  entries       Entry[]
  teams         Team[]
  weightClasses WeightClass[] // Only populated for KUMITE divisions
  draws         Draw[]

  @@index([eventId, key, gender])
  @@index([eventId, category, gender])
}

model WeightClass {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  gender     Gender
  name       String // e.g., "-57kg"
  minKg      Float?
  maxKg      Float?

  entries Entry[]
  draws   Draw[]

  @@index([eventId, gender])
  @@index([divisionId])
}

model Belt {
  id                  String  @id @default(cuid())
  name                String?
  colour              String?
  notes               String?
  gradingRequirements String?
  order               Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Athlete   Athlete[]
}

/// The katas a competitor may perform, as reference data rather than a
/// hardcoded list — the point of storing them is the rules that will hang off
/// them later (which katas a grade or an age band may use, what may not be
/// repeated between rounds), and none of that can be written against strings
/// typed on the day.
///
/// Global, like Belt, not per-event: the syllabus belongs to the style, and an
/// event that restricts it is restricting a subset of this list. When per-event
/// allowances arrive they should be a join off this table, not a copy of it.
model Kata {
  id    String @id @default(cuid())
  name  String @unique
  /// Style or syllabus the kata belongs to, e.g. "Goju-ryu", "Goju Kai".
  style String?
  /// Display order, beginner to advanced. Grouped in tens like Belt.order so
  /// a kata can be inserted between two others without renumbering.
  order Int
  /// Unticked rather than deleted when a kata leaves the syllabus: results
  /// already recorded against it must keep resolving to a name.
  active Boolean @default(true)
  notes  String?

  performances KataPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// What one competitor performed in one kata bout. Separate from the bout's
/// `scoreJson` on purpose: "which katas has this athlete already used in this
/// event" is the question every future rule asks, and it has to be a query,
/// not a JSON scan.
///
/// Cleared alongside the rest of a bout's score detail whenever that detail is
/// invalidated (winner-only override, upstream bracket correction) — a kata
/// recorded against a matchup that no longer exists is not a fact.
model KataPerformance {
  id      String @id @default(cuid())
  boutId  String
  bout    Bout   @relation(fields: [boutId], references: [id], onDelete: Cascade)
  entryId String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kataId  String
  kata    Kata   @relation(fields: [kataId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One kata per competitor per bout.
  @@unique([boutId, entryId])
  @@index([entryId])
  @@index([kataId])
}

model Athlete {
  id             String    @id @default(cuid())
  clubId         String
  club           Club      @relation(fields: [clubId], references: [id])
  firstName      String
  lastName       String
  invoiceRef     String?
  dob            DateTime
  gender         Gender
  nationality    String
  idType         String?
  idNumber       String?
  // Optional: a club may register an athlete before their grade is known or
  // confirmed. Null means "not recorded", never "no grade held".
  // onDelete is pinned to Restrict because Prisma defaults an *optional*
  // relation to SetNull: deleting a belt would silently regrade every athlete
  // holding it. BeltService.delete already refuses that with a 409; this keeps
  // the same promise at the database.
  beltId         String?
  belt           Belt?     @relation(fields: [beltId], references: [id], onDelete: Restrict)
  weightKg       Float?
  joinDate       DateTime?
  lastGraded     DateTime?
  isInstructor   Boolean   @default(false)
  isActive       Boolean   @default(true)
  medicalNotes   String?
  contactEmail   String?
  contactPhone   String?
  guardianName1  String?
  guardianPhone1 String?
  guardianName2  String?
  guardianPhone2 String?
  photoUrl       String?

  entries     Entry[]
  teamMembers TeamMember[]
  documents   Document[]

  // Club billing — see the billing section at the end of this file.
  subscriptions  MemberSubscription[]
  memberInvoices MemberInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([dob])
  @@index([gender])
}

model Entry {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id])

  // Individual entry
  athleteId String?
  athlete   Athlete? @relation(fields: [athleteId], references: [id])

  // Team entry (optional - when representing a team entry as a row here)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  entryType  EntryType
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id])

  // Used for Kumite individual
  weightClassId String?
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id])

  status       EntryStatus @default(DRAFT)
  /// Admin's reason when an entry is RETURNED; shown to the club. Cleared on submit/approve.
  statusReason String?
  /// Day-of presence flag; ticked at check-in, used by the run board.
  checkedIn    Boolean     @default(false)
  /// Manual seeding rank within this entry's category (division + weight class).
  /// A relative ordering rather than a literal bracket rank: gaps left by a
  /// withdrawn seeded athlete are compacted to dense ranks 1..N at draw time.
  /// null = unseeded, and all unseeded entries are equal. Uniqueness within a
  /// category is enforced in the service layer, not by @@unique — Postgres
  /// treats NULL weightClassId rows as distinct, so a DB constraint would
  /// silently not apply to KATA categories at all.
  seed         Int?
  feeCents     Int         @default(0)
  notes        String?

  drawSlots  DrawSlot[]
  boutsAsAka Bout[]     @relation("BoutAka")
  boutsAsAo  Bout[]     @relation("BoutAo")
  boutsWon   Bout[]     @relation("BoutWinner")
  kataPerformances KataPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uniqueness (two paths):
  // 1) individual: one unique entry per athlete per event/type/division
  @@unique([eventId, athleteId, entryType, divisionId])
  // 2) team: one unique entry per team per event/type/division
  @@unique([eventId, teamId, entryType, divisionId])
  // Fast filters
  @@index([eventId, divisionId, entryType, status])
  @@index([clubId, status])
  // Foreign-key indexes: Postgres does not create these automatically, and
  // without them every cascade/restrict check and every "entries for this
  // athlete/team/division/weight class" lookup sequentially scans Entry.
  @@index([athleteId])
  @@index([teamId])
  @@index([divisionId])
  @@index([weightClassId])
}

model Team {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id])
  name       String
  teamType   EntryType // use TEAM_KATA or TEAM_KUMITE
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id])

  status TeamStatus @default(DRAFT)

  members TeamMember[]
  entries Entry[] // optional: if you also create an Entry row for team

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, clubId, teamType, divisionId, status])
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id])
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])
  isReserve Boolean @default(false)

  @@unique([teamId, athleteId]) // an athlete appears at most once on a team
  @@index([athleteId])
}

model Invoice {
  id         String        @id @default(cuid())
  clubId     String
  club       Club          @relation(fields: [clubId], references: [id])
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id])
  totalCents Int
  status     InvoiceStatus @default(DUE)
  pdfUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, clubId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String // e.g., "Entry", "Team", "Athlete"
  entityId   String
  action     String // e.g., "CREATE", "UPDATE", "APPROVE", "RETURN"
  diffJson   String // store JSON string of changes
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

model Draw {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  divisionId    String
  division      Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  weightClassId String?
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id], onDelete: Cascade)

  size   Int // bracket size: 2, 4, 8, 16, 32
  status DrawStatus @default(DRAWN)
  /// When true the bracket is frozen: regenerate/delete are blocked until unlocked.
  locked Boolean    @default(false)

  // Day-of running: which mat this category runs on, and its order within the mat.
  matId    String?
  mat      Mat?    @relation(fields: [matId], references: [id], onDelete: SetNull)
  matOrder Int?

  slots DrawSlot[]
  bouts Bout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One draw per category (division, or division+weight class for kumite).
  // Postgres allows multiple NULL weightClassId rows, so the service also
  // guards against duplicates before creating.
  @@unique([eventId, divisionId, weightClassId])
  @@index([eventId])
  // FK index: the run-day board groups draws by mat.
  @@index([matId])
}

model DrawSlot {
  id       String @id @default(cuid())
  drawId   String
  draw     Draw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  position Int // 1..size; positions without a row are byes
  entryId  String
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Dense seed rank (1..N) actually used when this draw was generated; null =
  /// drawn as unseeded. Snapshotted so the bracket keeps showing what was drawn
  /// even if Entry.seed changes afterwards, and so seed drift is detectable at
  /// all: tier placement is randomised, so the seeding cannot be inferred from
  /// `position` alone.
  seed     Int?

  @@unique([drawId, position])
  @@unique([drawId, entryId])
  // FK index: entry deletion cascades here, and the entry-detail view looks up
  // an athlete's slots across draws (the [drawId, entryId] unique can't serve
  // an entryId-only lookup).
  @@index([entryId])
}

model Bout {
  id     String    @id @default(cuid())
  drawId String
  draw   Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  phase  BoutPhase @default(MAIN)
  // MAIN: round 1..log2(size), position = 0-based bout index within the round.
  // REPECHAGE: round = stage within the side, position = side (0 = top half, 1 = bottom half).
  round    Int
  position Int

  akaEntryId    String?
  akaEntry      Entry?  @relation("BoutAka", fields: [akaEntryId], references: [id], onDelete: SetNull)
  aoEntryId     String?
  aoEntry       Entry?  @relation("BoutAo", fields: [aoEntryId], references: [id], onDelete: SetNull)
  winnerEntryId String?
  winnerEntry   Entry?  @relation("BoutWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  // Optional WKF kumite scoring detail (winner-only results leave these null)
  akaScore  Int?
  aoScore   Int?
  outcome   String? // POINTS | GAP | SENSHU | HANTEI | HANSOKU | KIKEN
  scoreJson String? // full per-side breakdown + action log
  /// True when the captured score includes at least one action entered after
  /// the bout clock expired (the mat's short post-buzzer awarding window).
  /// Audit-trail flag only — scoring itself is never blocked by this. Reset
  /// to false whenever score detail is invalidated (winner-only override,
  /// upstream bracket correction), same as akaScore/aoScore/outcome/scoreJson.
  postTime Boolean @default(false)

  /// Set once, the first time the mat-side scoreboard starts this bout's
  /// clock (never by any other write path — the app has no other signal
  /// that a bout is "in progress", since scoring itself stays client-side
  /// until the final save). Reset to null whenever the result or fighters
  /// are invalidated, same reasoning as the score-detail fields above: a
  /// stale "in progress" flag pointing at the wrong matchup is worse than
  /// none. Read-only status ping for other viewers of the draw — never
  /// gates scoring itself.
  startedAt DateTime?

  // Per-bout mat override; null = inherit the draw's mat. Survives recompute
  // (recompute never writes matId), lost only if the bout row is deleted.
  matId String?
  mat   Mat?   @relation(fields: [matId], references: [id], onDelete: SetNull)

  // Manual within-mat running order set by the organizer on run day. null =
  // not manually ordered (sorts after ordered bouts, by natural bracket order).
  // Survives recompute like matId; lost only if the bout row is deleted.
  queueOrder Int?

  /// Kata performed by each competitor, for KATA categories. Empty for kumite.
  kataPerformances KataPerformance[]

  @@unique([drawId, phase, round, position])
  @@index([drawId])
  // FK indexes: the three Entry relations all cascade to SetNull on entry
  // delete, and results/board queries filter bouts by competitor or by mat.
  @@index([akaEntryId])
  @@index([aoEntryId])
  @@index([winnerEntryId])
  @@index([matId])
}

// A competition mat/tatami within an event. Categories (draws) are planned
// onto mats for day-of running; individual bouts may override the mat.
model Mat {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  order   Int    @default(0)

  draws          Draw[]
  bouts          Bout[]
  scheduleBlocks ScheduleBlock[]
  operators      MatOperator[]

  createdAt DateTime @default(now())

  @@index([eventId])
}

/// Who runs the bouts on one tatami. Many-to-many on purpose: a mat usually has
/// two people on it (one on the clock, one recording) and they change over
/// during the day, and one person may cover two mats when a floor is quiet.
///
/// Scoped to the mat, not the event: the mat carries the event, so the grant
/// disappears with the tournament and an operator can never reach last month's.
/// This is what `requireBoutScorer` checks before letting a result through, and
/// what `RunService.getOperatorBoard` filters the visible bouts by.
model MatOperator {
  id     String @id @default(cuid())
  matId  String
  mat    Mat    @relation(fields: [matId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("OperatorUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Who assigned them. Kept for accountability; null if that user is removed.
  grantedById String?
  grantedBy   User?   @relation("OperatorGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([matId, userId])
  @@index([userId])
}

/// A non-competition block in the day's plan: the opening and closing
/// ceremonies, lunch, or any other break the organizer wants on the schedule.
///
/// Deliberately its own table rather than derived from `Event.timingJson`:
/// the timing config holds *defaults* (is there a lunch, how long), while the
/// plan holds the concrete blocks the organizer has actually placed — which
/// floor they sit on, in what running order, at what time. Deriving them would
/// make "move lunch after the U14 pools on Mat 2" unrepresentable.
model ScheduleBlock {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  kind    ScheduleBlockKind
  label   String
  minutes Int

  /// null = the block spans every floor and is drawn as a band across the whole
  /// plan. Set = it sits inside that one mat's running order, interleaved with
  /// the mat's categories through `matOrder` (the two share one index space).
  ///
  /// Cascade, not SetNull: deleting a mat must not silently promote that mat's
  /// coffee break into a venue-wide stoppage.
  matId    String?
  mat      Mat?    @relation(fields: [matId], references: [id], onDelete: Cascade)
  matOrder Int?

  /// Venue-wide blocks only: "HH:MM" clock anchor for when the whole venue
  /// stops. null anchors the block to the day instead — OPENING runs before
  /// the first bout on every mat, CLOSING after the last one.
  startTime String?

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([matId])
}

enum ScheduleBlockKind {
  OPENING
  CLOSING
  LUNCH
  BREAK
}

model Document {
  id           String       @id @default(cuid())
  documentType DocumentType
  label        String?
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  athleteId    String?
  athlete      Athlete?     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clubId       String?
  club         Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([athleteId])
  @@index([eventId])
  @@index([clubId])
  @@index([uploadedById])
}

// ============================================================================
// Club billing — monthly member fees, payments and reconciliation.
//
// Entirely separate from the event-scoped `Invoice` model above, which bills a
// CLUB for a competition. This section bills a MEMBER for training. The two are
// never mixed; `prisma.invoice` and `prisma.memberInvoice` read differently at
// every call site on purpose.
//
// Every table here is club-scoped, and every route guards on ClubBillingConfig
// before touching them, so clubs that have not opted in are unaffected.
// ============================================================================

enum FeeType {
  MONTHLY
  GRADING
  TOURNAMENT_ENTRY
  CAMP
  REGISTRATION
  OTHER
}

enum FeeCadence {
  MONTHLY
  ONE_OFF
}

enum MemberInvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  WRITTEN_OFF
}

enum MemberInvoiceKind {
  SUBSCRIPTION
  ONE_OFF
}

enum PaymentMethod {
  EFT
  CASH
  CARD
  DEBIT_ORDER
  OTHER
}

/// Per-club opt-in switch and billing settings. A club with no row here has no
/// billing: every route returns 404, so the feature is invisible to it.
model ClubBillingConfig {
  id       String  @id @default(cuid())
  clubId   String  @unique
  club     Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  enabled  Boolean @default(false)
  currency String  @default("NAD")
  /// IANA zone. All billing date arithmetic resolves through this, never the
  /// server's local time.
  timezone String  @default("Africa/Windhoek")

  /// Member reference scheme: <refPrefix>-<zero-padded seq>, e.g. GKWI-0231.
  /// No default: a prefix identifies one club, so any default would be wrong
  /// for the next club and would collide on the globally-unique invoice ref.
  /// nextRefSeq is allocated inside the same transaction that assigns a ref,
  /// so references are never model- or client-generated.
  refPrefix  String
  nextRefSeq Int    @default(1)

  /// Day of month the monthly run targets, and how long members get to pay.
  invoiceDay   Int @default(1)
  dueDaysAfter Int @default(7)

  /// Calendar months (1-12) the club does not charge for — school holidays it
  /// closes through. Windhoek is [5, 12]. Stored rather than left to whoever
  /// runs the job to remember: running a closed month would generate an
  /// invoice per active member, all of which then need cancelling, and the
  /// mistake looks like a pricing decision rather than a slip.
  nonBillableMonths Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A priced thing a member can be billed for.
model FeeSchedule {
  id            String     @id @default(cuid())
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  code          String
  name          String
  feeType       FeeType
  cadence       FeeCadence
  amountCents   Int
  active        Boolean    @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  subscriptions MemberSubscription[]
  lines         MemberInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, code])
  @@index([clubId, active])
}

/// Who gets billed what. Deliberately an explicit row per member per fee
/// rather than a rules blob: the monthly run is then a pure function of
/// (club, period, subscriptions overlapping it, athlete.isActive), which a
/// human can check by hand. That is what "you approved but computed nothing"
/// requires.
model MemberSubscription {
  id            String      @id @default(cuid())
  athleteId     String
  athlete       Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  feeScheduleId String
  feeSchedule   FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  startDate     DateTime
  endDate       DateTime?
  quantity      Int         @default(1)
  /// Family discount, hardship rate. Overrides FeeSchedule.amountCents.
  overrideAmountCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, feeScheduleId, startDate])
  @@index([athleteId])
  @@index([feeScheduleId])
}

/// One month's generation for one club. Exists so the approval gate is a
/// single queue item per month rather than one per member — per-invoice
/// approval for a 50-member club is how "review everything" becomes
/// "approve everything".
model InvoiceRun {
  id           String    @id @default(cuid())
  clubId       String
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  periodKey    String
  status       String    @default("DRAFT") // DRAFT | APPROVED | CANCELLED
  invoiceCount Int       @default(0)
  totalCents   Int       @default(0)
  createdVia   String
  approvedAt   DateTime?

  invoices MemberInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, periodKey])
}

model MemberInvoice {
  id        String            @id @default(cuid())
  /// Denormalised from the athlete: every billing query filters on it, and a
  /// member moving club must not drag their invoice history along.
  clubId    String
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete           @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  kind      MemberInvoiceKind @default(SUBSCRIPTION)
  /// "2026-08" for subscription invoices; NULL for one-offs.
  periodKey String?

  issueDate DateTime
  dueDate   DateTime

  subtotalCents Int
  discountCents Int @default(0)
  totalCents    Int
  /// Maintained by recomputeInvoicePaidState inside the allocation
  /// transaction. Never incremented by hand.
  amountPaidCents Int @default(0)

  status MemberInvoiceStatus @default(DRAFT)
  /// <memberRef>-<YYMM>, e.g. KAR-0231-2608. Globally unique.
  paymentRef String @unique
  currency   String @default("NAD")

  runId String?
  run   InvoiceRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// Rendered PDF, stored via the existing Document model and Supabase bucket.
  pdfDocumentId String? @unique

  createdVia  String
  approvedAt  DateTime?
  sentAt      DateTime?
  cancelledAt DateTime?
  notes       String?

  lines       MemberInvoiceLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The anti-double-invoice guard, and the most important line here.
  /// Postgres treats NULLs as distinct, so this permits unlimited one-off
  /// invoices per athlete while making a second August subscription invoice
  /// physically impossible — a database-level guarantee that survives the
  /// agent stack being rebuilt from scratch.
  @@unique([clubId, athleteId, periodKey])
  @@index([clubId, status, dueDate])
  @@index([athleteId, status])
  @@index([clubId, periodKey])
}

model MemberInvoiceLine {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   MemberInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  feeScheduleId String?
  feeSchedule   FeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)

  description     String
  quantity        Int @default(1)
  unitAmountCents Int
  /// quantity * unitAmountCents, recomputed server-side — never trusted from
  /// the caller.
  amountCents     Int

  @@index([invoiceId])
  @@index([feeScheduleId])
}

/// Money received. Separate from its allocations because a payment is not an
/// invoice payment: three months paid up front is one bank line and three
/// allocations, and an overpayment leaves a credit that a single invoiceId FK
/// could not represent without lying.
model Payment {
  id           String        @id @default(cuid())
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  receivedDate DateTime
  /// Positive: money in.
  amountCents  Int
  currency     String        @default("NAD")
  method       PaymentMethod

  /// Raw fields as the bank wrote them. UNTRUSTED — a description can contain
  /// anything, and it reaches a model's context during reconciliation.
  bankReference String?
  description   String?

  /// CanonicalTransaction.hash. The authoritative replay guard, independent of
  /// the ingest file hash and of the agent idempotency table — the only one of
  /// the three that still holds if the agent stack is rebuilt.
  externalHash String? @unique

  source          String // "bank-csv" | "cash" | "manual"
  matchMethod     String? // "rule:exact-ref" | "rule:amount+name" | "rule:amount-in-period" | "agent-proposed" | "manual"
  matchConfidence Decimal? @db.Decimal(4, 3)
  recordedVia     String
  notes           String?

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, receivedDate])
  @@index([bankReference])
}

model PaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   MemberInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents Int
  createdVia  String

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}
